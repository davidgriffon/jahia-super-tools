<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jahia.modules</groupId>
        <artifactId>jahia-modules</artifactId>
        <version>8.2.0.0</version>
        <relativePath />
    </parent>

    <!--
        Community groupId on purpose: Jahia only enforces the module signature on org.jahia.modules artifacts,
        so this experimental module can be built and deployed without a keymaker signature.
    -->
    <groupId>org.jahia.community</groupId>
    <artifactId>jahia-super-tools</artifactId>
    <version>0.0.3-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <name>Jahia Super Tools</name>
    <description>
        Companion module for the Jahia Support Tools: user permissions inspector, output cache browser,
        assets usage checker and a React JCR browser. Each tool is listed in the "Modules" section of the
        Support Tools home page.
    </description>

    <scm>
        <connection>scm:git:git@github.com:davidgriffon/jahia-super-tools.git</connection>
        <!-- The host is a property so that a local SSH alias can be used for the release pushes (see the README). -->
        <developerConnection>scm:git:git@${github.ssh.host}:davidgriffon/jahia-super-tools.git</developerConnection>
        <url>https://github.com/davidgriffon/jahia-super-tools</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- The cache browser and the JCR browser extend the GraphQL API: wait for the provider before starting. -->
        <jahia-depends>graphql-dxm-provider</jahia-depends>
        <jahia-module-type>system</jahia-module-type>
        <jahia-static-resources>/css,/javascript</jahia-static-resources>
        <jahia-bom.version>8.2.0.0</jahia-bom.version>
        <graphql-dxm-provider.version>3.0.0</graphql-dxm-provider.version>
        <ehcache.version>2.10.9.2</ehcache.version>
        <yarn.arguments>build:production</yarn.arguments>
        <node.version>v22.14.0</node.version>
        <yarn.version>v1.22.22</yarn.version>
        <github.ssh.host>github.com</github.ssh.host>
        <github.packages.url>https://maven.pkg.github.com/davidgriffon/jahia-super-tools</github.packages.url>
    </properties>

    <!--
        Artifacts are published to GitHub Packages (https://github.com/davidgriffon?tab=packages).
        The "github" server must be declared in ~/.m2/settings.xml with a GitHub user name and a personal
        access token holding the write:packages scope.
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>${github.packages.url}</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>${github.packages.url}</url>
        </snapshotRepository>
    </distributionManagement>

    <repositories>
        <repository>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Jahia runtime: imported from the container, never embedded -->
        <dependency>
            <groupId>org.jahia.server</groupId>
            <artifactId>jahia-impl</artifactId>
            <version>${jahia-bom.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>graphql-dxm-provider</artifactId>
            <version>${graphql-dxm-provider.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.graphql-java</groupId>
            <artifactId>graphql-java-annotations</artifactId>
            <version>${graphql-java-annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
            <version>${graphql-java.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.sf.ehcache</groupId>
            <artifactId>ehcache</artifactId>
            <version>${ehcache.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.annotation</artifactId>
            <version>${osgi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
            <version>${osgi.compendium.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <version>${osgi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.jcr</groupId>
            <artifactId>jcr</artifactId>
            <version>2.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- JSON output of the bean editor API -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-databind.osgi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.osgi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>jsp-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- test-only dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <_dsannotations>*</_dsannotations>
                        <!--
                            The GraphQL annotation packages are exported by graphql-dxm-provider with versions that do
                            not match the compile-time artifacts, hence the explicit open ranges (same as the tools module).
                        -->
                        <Import-Package>
                            graphql.annotations.annotationTypes;version="[7.2,99)",
                            graphql.schema;version="[13.0,22)",
                            graphql;version="[13.0,22)",
                            com.fasterxml.jackson.core,
                            com.fasterxml.jackson.databind,
                            ${jahia.plugin.projectPackageImport},
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <executions>
                    <execution>
                        <id>install node and yarn</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-yarn</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <yarnVersion>${yarn.version}</yarnVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>yarn build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>yarn</goal>
                        </goals>
                        <configuration>
                            <arguments>${yarn.arguments}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <!-- The Jahia parent names profiles that do not exist in this module: use ours instead. -->
                    <releaseProfiles>release</releaseProfiles>
                    <preparationGoals>clean verify</preparationGoals>
                    <goals>deploy</goals>
                    <scmCommentPrefix>chore(release): </scmCommentPrefix>
                    <signTag>false</signTag>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <yarn.arguments>build</yarn.arguments>
            </properties>
        </profile>
        <profile>
            <!-- Activated by the release plugin during release:perform. -->
            <id>release</id>
            <properties>
                <yarn.arguments>build:production</yarn.arguments>
                <maven.javadoc.skip>true</maven.javadoc.skip>
            </properties>
        </profile>
    </profiles>
</project>
