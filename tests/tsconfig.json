  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["cypress", "node", "@jahia/cypress"]
  },
  "include": ["cypress/**/*.ts", "cypress.config.ts"]
}
